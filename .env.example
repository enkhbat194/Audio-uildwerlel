# GEMINI_API_KEY: Default AI Studio secret (Do NOT use as a substitute for Vertex AI ADC).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted Cloud Run service URL.
APP_URL="MY_APP_URL"

# Cloud Run Production Variables (never place secret keys or service account JSON here; attach Workload Identity):
# GCS_BUCKET_NAME="your-private-audio-factory-bucket"
# OWNER_EMAIL_ALLOWLIST="owner@example.com"
# FIRESTORE_DATABASE_ID="(default)"
# TTS_RATE_LIMIT_RPM="10"
